# =============================================================
#  oramon 접속 설정 (.env)
#  실제 사용시 이 파일을 복사해서 .env 로 저장
#    cp .env.example .env
#  .env 는 반드시 .gitignore 처리
# =============================================================

# ---- Oracle 접속 ----
# DSN 형식은 세 가지 다 지원:
#   1) EasyConnect       :  host:port/service_name
#   2) TNS 이름          :  tns:ORCLPRD   (tnsnames.ora 사용)
#   3) 전체 접속 문자열  :  (DESCRIPTION=(ADDRESS=...)(CONNECT_DATA=...))
ORAMON_DSN=inddb.indong.local:1521/ORCLPRD

ORAMON_USER=oramon_ro
ORAMON_PASSWORD=changeme

# SYSDBA 로 붙을지 여부 (true / false)
ORAMON_AS_SYSDBA=false

# 프로파일 이름 (TUI 헤더에 표시)
ORAMON_PROFILE=inddb-prod

# ---- 커넥션 풀 ----
ORAMON_POOL_MIN=2
ORAMON_POOL_MAX=8

# ---- 수집 주기 ----
# 밀리초 단위. 서버 부담 되면 늘리세요.
ORAMON_INTERVAL_FAST_MS=1000
ORAMON_INTERVAL_MED_MS=10000
ORAMON_INTERVAL_SLOW_MS=60000

# ---- 안전 모드 ----
# readonly | dba
# readonly 모드에서는 KILL / GATHER / FLUSH 등 destructive 액션 비활성
ORAMON_MODE=readonly

# ---- Oracle Instant Client 경로 (선택) ----
# 이미 LD_LIBRARY_PATH 잡혀있으면 비워두세요.
# LD_LIBRARY_PATH=/opt/oracle/instantclient_21_13

# ---- 로그 레벨 ----
# error | warn | info | debug | trace
RUST_LOG=oramon=info
