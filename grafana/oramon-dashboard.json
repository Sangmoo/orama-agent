        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "oramon_executions_per_sec", "legendFormat": "Executions/s", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "oramon_physical_reads_per_sec", "legendFormat": "Physical Reads/s", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "oramon_user_txn_per_sec", "legendFormat": "User Txn/s", "refId": "C" }
      ],
