# =============================================================
#  ORAMON Web 접속 설정 (예시)
#  복사해서 .env 로 저장 후 실제 값 채우기:   cp .env.example .env
# =============================================================

# Oracle Instant Client 경로 (Thick 모드, Oracle 11g 접속 시 필수)
ORACLE_CLIENT_PATH=C:\oracle\instantclient_23_7

# Oracle DB 접속 정보
DB_HOST=192.168.0.10
DB_PORT=1521
DB_SID=ORCL
DB_USER=monitor_user
# 비밀번호에 # $ 등 특수문자가 있으면 반드시 작은따옴표로 감쌀 것 (dotenv 가 # 를 주석 처리함)
DB_PASSWORD='changeme'

# 커넥션 풀
POOL_MIN=2
POOL_MAX=8

# 웹 서버 포트
PORT=3900

# 백그라운드 프로세스 표시 여부
SHOW_BACKGROUND=false

# 안전 모드: readonly(조회만, 기본) | dba(세션 KILL 등 개입 허용)
ORAMON_MODE=readonly

# 백그라운드 수집기
COLLECT_INTERVAL_MS=10000
HISTORY_POINTS=1080
CPU_SPIKE_PCT=85
BLOCK_ALERT_SEC=30
TS_ALERT_PCT=90
RETAIN_DAYS=7

# 로그인 인증 (T_USR/T_EMP 부서 212003). false 면 인증 없이 열림.
AUTH_ENABLED=true
AUTH_IDLE_MIN=480

# AI 튜닝 제안 (Claude API). 키는 서버에서만 사용됨.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
# 비용 가드레일: 캐시 TTL(분) / 신규호출 쿨다운(초) / 사용자별 1일 한도
TUNE_CACHE_TTL_MIN=1440
TUNE_COOLDOWN_SEC=15
TUNE_DAILY_LIMIT=30

# 이메일 알림 (SMTP). 수신자 등록은 웹 UI 설정 탭에서.
ALERT_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=oramon@yourcompany.com
